NODE_ENV=development
PORT=3000
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017/code-judge

# Comma separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Where the browser app lives. Verification and reset links point here.
# Don't use a trailing slash, because the backend app appends one when needed.
WEB_URL=http://localhost:5173

# Access tokens are signed with HS256 using this one secret.
# Make your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=code-judge
JWT_AUDIENCE=code-judge-web
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=14d

# bcrypt cost. 12 is about 200-300 ms. Measure it on your own machine.
BCRYPT_ROUNDS=12

# Leave empty on localhost. Set it only when the API and the web app share a
# parent domain in production.
COOKIE_DOMAIN=

# console:// prints the whole email, link included, to the log instead of
# sending it. Use a real URL for anything else, e.g. smtp://localhost:1025
# for Mailhog, or smtps://user:pass@smtp.provider.com for production.
SMTP_URL=console://
MAIL_FROM=no-reply@code-judge.dev
