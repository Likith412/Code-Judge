NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# The member advertises itself as mongo:27017, for phase 11. directConnection
# skips that lookup, which is what the API needs while it runs on the host.
MONGO_URI=mongodb://localhost:27017/code-judge?directConnection=true

# Allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173

# Frontend URL
WEB_URL=http://localhost:5173

# JWT settings
JWT_SECRET=
JWT_ISSUER=code-judge
JWT_AUDIENCE=code-judge-web
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=14d

# Password hashing cost
BCRYPT_ROUNDS=12

# Leave empty on localhost
COOKIE_DOMAIN=

# Password for the accounts npm run seed makes. Never used in production.
SEED_PASSWORD=codejudge-dev-pass

# Email service
SMTP_URL=console://
MAIL_FROM=no-reply@code-judge.dev

# Where the judge reaches Docker, e.g. unix:///var/run/docker.sock.
# Leave empty to use Docker Desktop's socket, or /var/run/docker.sock on Linux.
DOCKER_HOST=
